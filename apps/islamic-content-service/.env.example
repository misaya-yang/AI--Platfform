ISLAMIC_CONTENT_APP__HOST=0.0.0.0
ISLAMIC_CONTENT_APP__PORT=8091
ISLAMIC_CONTENT_APP__LOG_LEVEL=INFO

ISLAMIC_CONTENT_DATABASE__DSN=postgresql://islamic_content_app:change_me@postgres:5432/gateway
ISLAMIC_CONTENT_DATABASE__SCHEMA=islamic_content
ISLAMIC_CONTENT_DATABASE__POOL_MIN_SIZE=2
ISLAMIC_CONTENT_DATABASE__POOL_MAX_SIZE=10
ISLAMIC_CONTENT_DATABASE__AUTO_MIGRATE=true

ISLAMIC_CONTENT_CACHE__ENABLED=true
ISLAMIC_CONTENT_CACHE__REDIS_URL=redis://:111111@redis:6379/1
ISLAMIC_CONTENT_CACHE__TTL_SECONDS=86400
ISLAMIC_CONTENT_CACHE__META_TTL_SECONDS=300
ISLAMIC_CONTENT_CACHE__SUMMARY_TTL_SECONDS=60

ISLAMIC_CONTENT_QURAN__BASE_URL=https://apis.quran.foundation/content/api/v4
ISLAMIC_CONTENT_QURAN__AUTH_URL=https://oauth2.quran.foundation
ISLAMIC_CONTENT_QURAN__CLIENT_ID=
ISLAMIC_CONTENT_QURAN__CLIENT_SECRET=
ISLAMIC_CONTENT_QURAN__SCOPE=content
ISLAMIC_CONTENT_QURAN__DEFAULT_TRANSLATION_ID=20
ISLAMIC_CONTENT_QURAN__DEFAULT_RECITATION_ID=7
ISLAMIC_CONTENT_QURAN__WORD_FIELDS=text_uthmani,text_uthmani_simple,text_imlaei
ISLAMIC_CONTENT_QURAN__PAGE_SIZE=50
ISLAMIC_CONTENT_QURAN__SYNC_ALL_TRANSLATIONS=true
ISLAMIC_CONTENT_QURAN__SYNC_ALL_RECITATIONS=true
ISLAMIC_CONTENT_QURAN__TRANSLATION_IDS=
ISLAMIC_CONTENT_QURAN__RECITATION_IDS=
ISLAMIC_CONTENT_QURAN__TRANSLATION_BATCH_SIZE=50
ISLAMIC_CONTENT_QURAN__TRANSLATION_CONCURRENCY=4
ISLAMIC_CONTENT_QURAN__RECITATION_CONCURRENCY=4

ISLAMIC_CONTENT_QURAN_USER__ENABLED=false
ISLAMIC_CONTENT_QURAN_USER__CLIENT_ID=
ISLAMIC_CONTENT_QURAN_USER__CLIENT_SECRET=
ISLAMIC_CONTENT_QURAN_USER__AUTH_URL=https://oauth2.quran.foundation
ISLAMIC_CONTENT_QURAN_USER__API_BASE_URL=https://api.quran.foundation/api/v1
ISLAMIC_CONTENT_QURAN_USER__REDIRECT_URI=
ISLAMIC_CONTENT_QURAN_USER__POST_LOGOUT_REDIRECT_URI=
ISLAMIC_CONTENT_QURAN_USER__SCOPES=openid,profile,email,offline_access

ISLAMIC_CONTENT_HADITH__BASE_URL=https://api.sunnah.com/v1
ISLAMIC_CONTENT_HADITH__API_KEY=
ISLAMIC_CONTENT_HADITH__SYNC_COLLECTIONS=bukhari,muslim,abudawud
ISLAMIC_CONTENT_HADITH__PAGE_SIZE=50

ISLAMIC_CONTENT_BOOTSTRAP__ON_START=false
ISLAMIC_CONTENT_BOOTSTRAP__FAIL_IF_EMPTY=false
