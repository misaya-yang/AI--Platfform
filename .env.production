# =============================================================================
# AI Gateway - Production Environment Configuration
# =============================================================================
# Copy this file to .env and modify the values for your environment.
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# =============================================================================
# Infrastructure Services
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=gateway
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your-strong-password-here
REDIS_PORT=6379

# Qdrant Configuration
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# =============================================================================
# Application Configuration
# =============================================================================

# Gateway Server
GATEWAY_PORT=8080
TASK_WORKER_CONCURRENCY=4

# Frontend
FRONTEND_PORT=80

# Docker Image Tag
TAG=latest

# =============================================================================
# Security Configuration
# =============================================================================

# JWT Secret (MUST change in production!)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-256-bit-secret-key-change-in-production

# =============================================================================
# LangGraph Configuration (Optional)
# =============================================================================

LANGGRAPH_ENABLED=false
LANGGRAPH_INSTANCE_URLS=
LANGGRAPH_AUTH_TOKEN=

# =============================================================================
# Knowledge Base Configuration
# =============================================================================

KNOWLEDGE_WORKER_CONCURRENCY=2

# OpenAI API for Embeddings (Optional)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# DashScope API for Embeddings (Optional - Aliyun)
# DASHSCOPE_API_KEY=sk-xxx

# =============================================================================
# Proxy Configuration
# =============================================================================

PROXY_BILLING_ENABLED=false

# =============================================================================
# File Upload Configuration
# =============================================================================

MAX_FILE_SIZE_MB=50
FILE_TTL_DAYS=7
FILE_USER_QUOTA_MB=500
