{
  "name": "hejaz-ai-cli",
  "version": "1.4.0",
  "description": "Hejaz AI CLI — Claude Code-like terminal AI assistant with OS Agent, MCP, and knowledge base integration",
  "type": "module",
  "bin": {
    "hejaz": "dist/cli.js"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "assistant",
    "agent",
    "mcp",
    "os-agent",
    "terminal",
    "hejaz"
  ],
  "author": "Hejaz AI Gateway Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hejaz/ai-gateway.git",
    "directory": "sdk/cli"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {},
  "devDependencies": {
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/node": "^22.10.0",
    "meow": "^13.2.0",
    "fast-glob": "^3.3.3",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0",
    "cli-highlight": "^2.1.11",
    "chalk": "^5.4.1",
    "typescript": "^5.7.0",
    "esbuild": "^0.24.0",
    "vitest": "^2.1.0"
  }
}
