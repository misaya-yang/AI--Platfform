{
  "name": "ai-gateway-cli",
  "version": "1.5.0",
  "description": "AI Gateway CLI — remote streaming chat with slash commands and knowledge base integration",
  "type": "module",
  "bin": {
    "ai-gateway": "dist/cli.js"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "assistant",
    "agent",
    "mcp",
    "chat",
    "slash-commands",
    "terminal",
    "gateway"
  ],
  "author": "AI Gateway Maintainers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaya-yang/AI--Platfform.git",
    "directory": "sdk/cli"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {},
  "devDependencies": {
    "ink": "^7.0.6",
    "ink-text-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.7",
    "@types/react": "^19.2.17",
    "@types/node": "^25.9.3",
    "meow": "^14.1.0",
    "fast-glob": "^3.3.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "cli-highlight": "^2.1.11",
    "chalk": "^5.6.2",
    "typescript": "^6.0.3",
    "esbuild": "^0.28.1",
    "vitest": "^4.1.9"
  }
}
