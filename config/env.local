# AI Gateway 环境变量配置
# 复制此文件为 .env 到项目根目录

# ============ 基础配置 ============
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_SERVICES_PATH=services

# ============ 数据库配置 ============
GATEWAY_DATABASE__ENABLED=true
GATEWAY_DATABASE__DSN=postgresql://postgres:111111@127.0.0.1:5433/gateway
# 自动初始化数据库表结构（首次运行缺表时执行 database/schema.sql）
GATEWAY_DATABASE__AUTO_INIT=true

# ============ Redis 配置 ============
GATEWAY_REDIS__ENABLED=true
GATEWAY_REDIS__URL=redis://:111111@127.0.0.1:6379/0

# ============ JWT 认证配置 ============
GATEWAY_AUTHENTICATION__JWT__ENABLED=false
GATEWAY_AUTHENTICATION__JWT__SECRET=your-jwt-secret-key
GATEWAY_AUTHENTICATION__JWT__ALGORITHMS=["HS256"]
# GATEWAY_AUTHENTICATION__JWT__AUDIENCE=your-audience
# GATEWAY_AUTHENTICATION__JWT__ISSUER=your-issuer

# ============ API Key 认证配置 ============
GATEWAY_AUTHENTICATION__API_KEY__ENABLED=false
GATEWAY_AUTHENTICATION__API_KEY__HEADER_NAME=X-API-Key
# GATEWAY_AUTHENTICATION__API_KEY__KEYS=["key1","key2"]

# ============ LangGraph 配置 ============
GATEWAY_LANGGRAPH__ENABLED=true
GATEWAY_LANGGRAPH__LOAD_BALANCER_STRATEGY=least_connections
GATEWAY_LANGGRAPH__HEALTH_CHECK_INTERVAL=10

# LangGraph 实例 URL（逗号分隔，支持多实例）
GATEWAY_LANGGRAPH__INSTANCE_URLS=http://127.0.0.1:2024

# LangGraph 内部认证 Token
# 如果 LangGraph 服务配置了自定义认证，需要设置此 token
# 这个 token 用于网关与 LangGraph 服务之间的通信
GATEWAY_LANGGRAPH__AUTH_TOKEN=gateway-internal-token

# ============ 限流配置 ============
GATEWAY_RATE_LIMITS__ENABLED=false
# GATEWAY_RATE_LIMITS__GLOBAL_LIMIT={"requests": 10000, "window": 60}
# GATEWAY_RATE_LIMITS__IP_LIMITS={"requests": 30, "window": 60}

# ============ Knowledge Base (KBMS) ============
GATEWAY_KNOWLEDGE__ENABLED=true
GATEWAY_KNOWLEDGE__WORKER_CONCURRENCY=2
GATEWAY_KNOWLEDGE__QDRANT__ENABLED=true
GATEWAY_KNOWLEDGE__QDRANT__URL=http://127.0.0.1:6333
# GATEWAY_KNOWLEDGE__QDRANT__API_KEY=
# GATEWAY_KNOWLEDGE__OPENAI__API_KEY=...
# OpenAI-compatible endpoints (you can point this to DashScope compatible-mode if desired)
GATEWAY_KNOWLEDGE__OPENAI__BASE_URL=https://api.openai.com/v1
# e.g. https://dashscope.aliyuncs.com/compatible-mode/v1

# DashScope (Aliyun) SDK key (used by embedding_provider=dashscope and DashScope rerank)
# GATEWAY_KNOWLEDGE__DASHSCOPE__API_KEY=...
# Also supported for convenience: DASHSCOPE_API_KEY / Aliyun_KEY / ALIYUN_KEY

# ============ LLM 配置 (QA 测试) ============
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-f066077586854c99adf0554dbe6b846d

# ============ 其他配置 ============
GATEWAY_HEALTH_CHECK_INTERVAL=30
GATEWAY_TASK_WORKER_CONCURRENCY=2
