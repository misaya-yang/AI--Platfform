# =============================================================================
# AI Gateway local quickstart environment
# =============================================================================
# `make quickstart` creates .env with private infrastructure secrets. For the
# default Qwen path, the only user-supplied secret is DASHSCOPE_API_KEY.
# Published application images are versioned and can be overridden below.
# =============================================================================

# -- Published application images --------------------------------------------
# Keep release tags immutable. Contributors who need source builds should run
# `make quickstart-build`; the normal quickstart never builds source locally.
GATEWAY_IMAGE=ghcr.io/misaya-yang/ai-gateway:2.0.0
FRONTEND_IMAGE=ghcr.io/misaya-yang/ai-gateway-web:2.0.0
ASSISTANT_IMAGE=ghcr.io/misaya-yang/ai-gateway-assistant-service:2.0.0
KNOWLEDGE_IMAGE=ghcr.io/misaya-yang/ai-gateway-knowledge-service:2.0.0
MIGRATE_IMAGE=ghcr.io/misaya-yang/ai-gateway-migrate:2.0.0

# -- Host ports ---------------------------------------------------------------
GATEWAY_PORT=8080
FRONTEND_PORT=8081
KNOWLEDGE_SERVICE_PORT=8092

# Bind infra ports to 127.0.0.1 via docker-compose.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# -- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_generate_with_openssl
POSTGRES_DB=gateway
# Keep true for a fresh database. Set false after the per-service migrate job.
GATEWAY_DATABASE_AUTO_INIT=true

# -- Redis --------------------------------------------------------------------
REDIS_PASSWORD=change_me_generate_with_openssl

# -- Gateway auth and service-to-service HMAC ---------------------------------
JWT_SECRET=change_me_generate_with_openssl_32_bytes_minimum
GATEWAY_ASSISTANT_SHARED_SECRET=change_me_generate_with_openssl_32_bytes_minimum
GATEWAY_ENCRYPTION_KEY=change_me_generate_with_openssl_32_bytes_minimum
# Internal communication defaults. v2 binds request semantics and identity;
# Redis provides replay protection shared across workers and replicas.
INTERNAL_COMM_STATE_BACKEND=redis
INTERNAL_COMM_REDIS_URL=redis://:change_me_generate_with_openssl@redis:6379/3
INTERNAL_AUTH_VERSION=v2
INTERNAL_AUTH_ACTIVE_KEY_ID=local
INTERNAL_AUTH_KEYS=
SERVICE_RETRY_MAX_ATTEMPTS=2
SERVICE_RETRY_BASE_DELAY_MS=50
SERVICE_RETRY_MAX_DELAY_MS=500
SERVICE_RETRY_BUDGET_RATIO=0.1
SERVICE_BREAKER_THRESHOLD=3
SERVICE_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
INTERNAL_SERVICE_RATE_LIMITS=knowledge-service=100:100,assistant-service=50:50
SERVICE_STREAMING_MAX_CONNECTIONS=16
ADMISSION_TENANT_SHARE_RATIO=0.2
ADAPTIVE_LOAD_SHEDDING_WINDOW_SECONDS=30
ADAPTIVE_LOAD_SHEDDING_LOW_THRESHOLD_MS=5000
ADAPTIVE_LOAD_SHEDDING_NORMAL_THRESHOLD_MS=10000
ADAPTIVE_LOAD_SHEDDING_HIGH_THRESHOLD_MS=20000
INTERNAL_IDEMPOTENCY_BACKEND=memory
INTERNAL_IDEMPOTENCY_TTL_SECONDS=86400
ADAPTER_BULKHEAD_LIMITS=langgraph:8,openai:16,comfyui:4
AUTH_ALLOWED_EMAIL_DOMAIN=example.com
# The initializer generates the local bootstrap admin password. Read the local
# .env file when you need to sign in; generated values are never printed.
DEFAULT_USER_PASSWORD=change_me_generate_with_openssl
# Leave API URLs blank to use the frontend origin and nginx /api proxy. For
# shared or non-local deployments, explicit absolute browser runtime URLs must
# use https and must not point at localhost or loopback.
VITE_API_URL=
VITE_API_BASE_URL=
# Absolute browser-facing console origin used only after OAuth callbacks.
# Leave blank for a same-origin relative redirect. Do not use the CORS list as
# a routing preference when several console deployments are allowed.
CONSOLE_PUBLIC_BASE_URL=
# For shared or non-local deployments, set this to the same value as
# AUTH_ALLOWED_EMAIL_DOMAIN so username-only login uses the backend-accepted
# email domain.
VITE_AUTH_EMAIL_DOMAIN=example.com
# Leave blank to default to admin@AUTH_ALLOWED_EMAIL_DOMAIN.
VITE_SUPPORT_EMAIL=
VITE_TELEMETRY_ENDPOINT=
VITE_SSE_DEBUG=
VITE_AGENT_STUDIO_ENABLED=true

# -- Optional Docker egress proxy --------------------------------------------
# Use this when the host reaches model providers through a local proxy. In
# Docker Desktop, containers must use host.docker.internal instead of 127.0.0.1.
# Example: CONTAINER_HTTP_PROXY=http://host.docker.internal:7890
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_ALL_PROXY=
CONTAINER_NO_PROXY=localhost,127.0.0.1,::1,postgres,redis,qdrant,gateway,frontend,knowledge-service,assistant-service

# -- Local quickstart rate limits --------------------------------------------
# These defaults are generous enough for page-load API bursts and assistant
# testing on localhost. Lower them for shared or production deployments.
RATE_LIMIT_IP_ENABLED=true
RATE_LIMIT_IP_LIMIT=500
RATE_LIMIT_ANONYMOUS_LIMIT=200
RATE_LIMIT_NORMAL_LIMIT=300
RATE_LIMIT_PREMIUM_LIMIT=1000
RATE_LIMIT_ENTERPRISE_LIMIT=5000
RATE_LIMIT_ADMIN_LIMIT=10000
RATE_LIMIT_ASSISTANT_CHAT_LIMIT=240

# -- Internal service URLs ----------------------------------------------------
# In Docker, keep these service names. Change only for non-compose deployments.
ASSISTANT_SERVICE_URL=http://assistant-service:8093
ASSISTANT_ROUTE_SESSIONS_PROXIED=true
ASSISTANT_RUNTIME_MEMORY_V2=true
ASSISTANT_RUNTIME_CONTEXT_V2=true
ASSISTANT_RUNTIME_TOOL_POLICY_V2=false
ASSISTANT_GATEWAY_ENABLED=true
ASSISTANT_RUNTIME_SKILLS=true
# Optional os.pathsep-delimited Agent Plugins 1.0.0 directories. The bundled
# docgen plugin uses a trusted stdio MCP child; ai-quiz is data-only, and the
# community plugins contain read-only Agent definitions. None is a trusted
# executable root except ai-docgen.
ASSISTANT_AGENT_PLUGIN_PATHS=/opt/agent-plugins/ai-docgen:/opt/agent-plugins/ai-quiz:/opt/agent-plugins/community-doublecheck:/opt/agent-plugins/community-engineering-reviewers
ASSISTANT_AGENT_PLUGIN_DATA_ROOT=/app/data/agent-plugins
# Built-in plugin identities explicitly trusted for platform-owned risk policy.
# Trust also requires an independently configured canonical installation root;
# third-party package metadata cannot grant itself unattended execution.
ASSISTANT_TRUSTED_AGENT_PLUGINS=ai-docgen@1.0.0
ASSISTANT_TRUSTED_AGENT_PLUGIN_ROOTS=/opt/agent-plugins/ai-docgen
ASSISTANT_RUNTIME_SCHEDULER=false
ASSISTANT_RUNTIME_FAILOVER_V2=false
# Ordered, explicit primary-to-fallback model IDs. Used only when the flag above is true.
ASSISTANT_MODEL_FALLBACKS_JSON={}
ASSISTANT_CODE_EXECUTOR_ENABLED=false
ASSISTANT_ALLOW_RUNC_CODE_EXECUTOR=false
ASSISTANT_ENABLE_PRIMITIVES=false
ASSISTANT_BUILTIN_DOMAIN_POLICY_ENABLED=false
ASSISTANT_OS_AGENT_LITE=false
ASSISTANT_REQUIRE_DB=true
ASSISTANT_REQUIRE_REDIS=false
ASSISTANT_APP__ALLOW_ANONYMOUS=false
ASSISTANT_REDIS__ENABLED=true
ASSISTANT_TOOL_OUTPUT_SPILL_ENABLED=true
ASSISTANT_TOOL_OUTPUT_SPILL_THRESHOLD_CHARS=100000
ASSISTANT_TOOL_ARTIFACT_READ_MAX_TOKENS=8000
ASSISTANT_STAGED_COMPACTION_ENABLED=false
ASSISTANT_STAGED_COMPACTION_MIN_SOURCE_TOKENS=4000
ASSISTANT_SKILL_CANDIDATE_HARD_LIMIT=64
ASSISTANT_READ_ONLY_TOOL_PARALLELISM=4
ASSISTANT_SUBAGENTS_ENABLED=false
# Process-wide AgentLoop ceilings. Tenant/request limits may only narrow these.
ASSISTANT_PARENT_HARD_TOOL_ITERATIONS=32
ASSISTANT_PARENT_INITIAL_TOOL_ITERATIONS=8
ASSISTANT_RUN_MAX_MODEL_TURNS=96
ASSISTANT_RUN_MAX_TOOL_CALLS=256
ASSISTANT_RUN_MAX_WALL_TIME_SECONDS=1800
ASSISTANT_RUN_MAX_TOOL_RESULT_BYTES=8000000
ASSISTANT_DEFAULT_EXECUTION_PROFILE=safe
ASSISTANT_DEFAULT_MEMORY_MODE=auto
AGENT_STUDIO_RUNTIME_ENABLED=true
AGENT_STUDIO_MANAGEMENT_ENABLED=true
AGENT_STUDIO_PUBLISH_ENABLED=true
AGENT_STUDIO_MCP_ENABLED=true
ASSISTANT_MCP_CLIENT_CACHE_TTL_SECONDS=60
ASSISTANT_MCP_CLIENT_CACHE_MAX_ENTRIES=100
AGENT_STUDIO_SKILLS_ENABLED=true
KB_SERVICE_URL=http://knowledge-service:8092
KNOWLEDGE_RUNTIME_ROLE=all
KNOWLEDGE_QDRANT_INTERACTIVE_DEADLINE_SECONDS=3
KNOWLEDGE_WORKER_MEMORY_LIMIT=512m
KB_PROXY_CONNECT_TIMEOUT_SECONDS=5
KB_PROXY_READ_TIMEOUT_SECONDS=30
KB_PROXY_WRITE_TIMEOUT_SECONDS=10
KB_PROXY_POOL_TIMEOUT_SECONDS=10
KB_PROXY_MAX_CONNECTIONS=50
KB_PROXY_MAX_KEEPALIVE_CONNECTIONS=10
# -- CORS ---------------------------------------------------------------------
# JSON array string. Keep the double quotes inside the value. For shared or
# non-local deployments, replace localhost with your https frontend origin.
KNOWLEDGE_CORS_ALLOW_ORIGINS_JSON=["http://localhost:8081","http://localhost:3000"]
ASSISTANT_CORS_ALLOW_ORIGINS_JSON=["http://localhost:8081","http://localhost:3000"]
ASSISTANT_E2E_STUB_LLM=false

# -- Chat model keys ----------------------------------------------------------
# `ui` lets the stack boot into provider setup with no model key. Use
# `environment` when deployment must fail until a provider key is preseeded.
MODEL_SETUP_MODE=ui
# Server-side default model applied when SDKs/console omit model_id.
DEFAULT_MODEL=qwen3.7-plus
# Deterministic quiz-generation fallback when the model registry is unreachable.
QUIZ_DETERMINISTIC_FALLBACK_ENABLED=false
# Primary live chat provider is DashScope/Qwen (`qwen3.7-plus`). Supplying this
# one key is enough for default chat, knowledge embeddings, and document
# generation. All other provider keys are optional compatibility overrides.
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_API_KEY=
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_EMBEDDING_API_KEY=
# Non-secret endpoint overrides. Per-domain values take precedence over the
# general value. Chat/embedding retain their existing defaults when empty.
# qwen3-rerank is region scoped and intentionally has no implicit China
# endpoint. Set DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com for the
# shared Singapore API, or set DASHSCOPE_RERANK_BASE_URL to a complete regional
# workspace endpoint ending in /compatible-api/v1/reranks.
DASHSCOPE_BASE_URL=
DASHSCOPE_CHAT_BASE_URL=
# Versioned upstream wire opt-in. Keep chat_completions for the default Qwen
# quickstart; use responses_v1 only with a verified Responses-compatible base.
DASHSCOPE_CHAT_WIRE_PROTOCOL=chat_completions
DASHSCOPE_EMBEDDING_BASE_URL=
DASHSCOPE_IMAGE_BASE_URL=
# Current international text-to-image model. Keep this explicit so operators
# can pin a region-compatible model instead of inheriting a removed legacy ID.
DASHSCOPE_IMAGE_MODEL=wan2.6-t2i
DASHSCOPE_RERANK_BASE_URL=
DASHSCOPE_RERANK_REQUEST_SCHEMA=auto
DASHSCOPE_RERANK_INSTRUCT=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_BACKEND=
GOOGLE_CHAT_BACKEND=
VERTEX_API_KEY=
VERTEX_CHAT_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Upstream provider wire only; this does not expose a gateway /v1/responses API.
OPENAI_WIRE_PROTOCOL=chat_completions
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# -- Knowledge-base embeddings ------------------------------------------------
# Supported providers: gemini, dashscope, siliconflow. The default reuses
# DASHSCOPE_API_KEY, so KB_EMBEDDING_API_KEY remains empty unless a dedicated
# key is desired.
KB_EMBEDDING_PROVIDER=dashscope
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=text-embedding-v4
KB_EMBEDDING_DIMENSION=1024
SILICONFLOW_API_KEY=

# -- KB RAGAS judge ----------------------------------------------------------
# Provider credentials are resolved from the server environment above. These
# values never accept caller-supplied API keys, endpoints, prompts, or timeouts.
KB_RAGAS_JUDGE_PROVIDER=dashscope
KB_RAGAS_JUDGE_MODEL=qwen3.7-plus
KB_RAGAS_JUDGE_BASE_URL=
KB_RAGAS_ALLOWED_PROVIDERS_JSON=["dashscope"]
KB_RAGAS_ALLOWED_MODELS_JSON=["qwen3.7-plus"]
KB_RAGAS_JUDGE_TIMEOUT_SECONDS=60
KB_RAGAS_REQUEST_TIMEOUT_SECONDS=180

# -- Local storage by default -------------------------------------------------
# Use local for quickstart. Switch to s3 only after filling the S3 block.
GATEWAY_STORAGE__BACKEND=local
GATEWAY_STORAGE__LOCAL_BASE_PATH=/app/data/images
KNOWLEDGE_STORAGE__LOCAL_BASE_PATH=/app/data/files
GATEWAY_STORAGE__KEY_PREFIX=dev

# Optional S3-compatible storage.
GATEWAY_STORAGE__S3__BUCKET=
GATEWAY_STORAGE__S3__REGION=us-east-1
GATEWAY_STORAGE__S3__ACCESS_KEY=
GATEWAY_STORAGE__S3__SECRET_KEY=
GATEWAY_STORAGE__S3__ENDPOINT_URL=
GATEWAY_STORAGE__URL_EXPIRY_SECONDS=3600

# -- Optional services --------------------------------------------------------
GATEWAY_LANGGRAPH__ENABLED=false
GATEWAY_LANGGRAPH__INSTANCE_URLS=
GATEWAY_LANGGRAPH__AUTH_TOKEN=
PROXY_BILLING_ENABLED=false
GATEWAY_TASK_WORKER_CONCURRENCY=1
GATEWAY_KNOWLEDGE__WORKER_CONCURRENCY=1

# -- Local Docker memory envelope --------------------------------------------
# Defaults keep the complete stack usable on a roughly 4 GiB Docker budget.
# Raise these values for production workloads.
POSTGRES_MEMORY_LIMIT=384m
REDIS_MEMORY_LIMIT=256m
REDIS_MAXMEMORY=192mb
QDRANT_MEMORY_LIMIT=384m
GATEWAY_MEMORY_LIMIT=512m
FRONTEND_MEMORY_LIMIT=128m
KNOWLEDGE_MEMORY_LIMIT=512m
ASSISTANT_MEMORY_LIMIT=640m

# Doc generation uses DashScope when available. DOCGEN_LLM_ENDPOINT is the
# complete OpenAI-compatible chat-completions endpoint; leave empty for CN.
DOCGEN_LLM_MODEL=
DOCGEN_LLM_ENDPOINT=
# Native Qdrant BM25 v2 is shadow-only until explicitly enabled after canary,
# backfill, and eval receipts. This is the service-wide emergency kill switch.
KB_BM25_V2_ENABLED=false
KB_BM25_V2_CAPABILITY_TTL_SECONDS=300
KB_BM25_V2_READINESS_TTL_SECONDS=5
