# =============================================================================
# AI Gateway Configuration
# =============================================================================
# Copy this file to .env and modify the values as needed.
# DO NOT commit .env to version control!
# =============================================================================

# ======================== Server ========================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_SERVICES_PATH=services
GATEWAY_HEALTH_CHECK_INTERVAL=30
GATEWAY_TASK_WORKER_CONCURRENCY=2

# ======================== Database (PostgreSQL) ========================
GATEWAY_DATABASE__ENABLED=true
GATEWAY_DATABASE__DSN=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gateway
# Auto-initialize database schema on first run (runs database/schema.sql)
GATEWAY_DATABASE__AUTO_INIT=true

# ======================== Redis ========================
GATEWAY_REDIS__ENABLED=true
GATEWAY_REDIS__URL=redis://:YOUR_PASSWORD@localhost:6379/0

# ======================== Authentication - JWT ========================
GATEWAY_AUTHENTICATION__JWT__ENABLED=false
GATEWAY_AUTHENTICATION__JWT__SECRET=your-jwt-secret-key-change-in-production
GATEWAY_AUTHENTICATION__JWT__ALGORITHMS=["HS256"]
# GATEWAY_AUTHENTICATION__JWT__AUDIENCE=your-audience
# GATEWAY_AUTHENTICATION__JWT__ISSUER=your-issuer

# ======================== Authentication - API Key ========================
GATEWAY_AUTHENTICATION__API_KEY__ENABLED=false
GATEWAY_AUTHENTICATION__API_KEY__HEADER_NAME=X-API-Key
# GATEWAY_AUTHENTICATION__API_KEY__KEYS=["key1","key2"]

# ======================== Rate Limiting ========================
GATEWAY_RATE_LIMITS__ENABLED=false
# GATEWAY_RATE_LIMITS__GLOBAL_LIMIT={"requests": 10000, "window": 60}
# GATEWAY_RATE_LIMITS__IP_LIMITS={"requests": 30, "window": 60}

# ======================== LangGraph ========================
GATEWAY_LANGGRAPH__ENABLED=true
GATEWAY_LANGGRAPH__LOAD_BALANCER_STRATEGY=least_connections
GATEWAY_LANGGRAPH__HEALTH_CHECK_INTERVAL=10
# Comma-separated URLs for multiple instances
GATEWAY_LANGGRAPH__INSTANCE_URLS=http://localhost:2024
# Internal auth token for gateway <-> LangGraph communication
GATEWAY_LANGGRAPH__AUTH_TOKEN=your-internal-token

# ======================== Knowledge Base (KBMS) ========================
GATEWAY_KNOWLEDGE__ENABLED=true
GATEWAY_KNOWLEDGE__WORKER_CONCURRENCY=2

# Qdrant Vector Database
GATEWAY_KNOWLEDGE__QDRANT__ENABLED=true
GATEWAY_KNOWLEDGE__QDRANT__URL=http://localhost:6333
# GATEWAY_KNOWLEDGE__QDRANT__API_KEY=

# OpenAI-compatible API (for embeddings)
# GATEWAY_KNOWLEDGE__OPENAI__API_KEY=sk-xxx
GATEWAY_KNOWLEDGE__OPENAI__BASE_URL=https://api.openai.com/v1

# DashScope (Aliyun) - for embeddings and rerank
# GATEWAY_KNOWLEDGE__DASHSCOPE__API_KEY=sk-xxx
# Convenience aliases (also supported)
# DASHSCOPE_API_KEY=sk-xxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ======================== Transparent Proxy ========================
GATEWAY_PROXY__ENABLED=true
GATEWAY_PROXY__TIMEOUT_CONNECT=5.0
GATEWAY_PROXY__TIMEOUT_READ=300.0
GATEWAY_PROXY__TIMEOUT_WRITE=60.0
GATEWAY_PROXY__BILLING_ENABLED=true

# ======================== Anonymous Identity ========================
GATEWAY_ANONYMOUS__ENABLED=true
GATEWAY_ANONYMOUS__COOKIE_NAME=ag_anon_id
GATEWAY_ANONYMOUS__TTL_DAYS=30

# ======================== Session ========================
GATEWAY_SESSION__ANONYMOUS_TTL_SECONDS=86400
GATEWAY_SESSION__AUTHENTICATED_TTL_SECONDS=604800
