# =============================================================================
# AI Gateway Configuration
# =============================================================================
# Copy this file to .env and modify the values as needed.
# DO NOT commit .env to version control!
# =============================================================================

# ======================== Server ========================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_SERVICES_PATH=services
GATEWAY_HEALTH_CHECK_INTERVAL=30
GATEWAY_TASK_WORKER_CONCURRENCY=2

# ======================== Database (PostgreSQL) ========================
GATEWAY_DATABASE__ENABLED=true
GATEWAY_DATABASE__DSN=postgresql://postgres:YOUR_PASSWORD@localhost:5432/gateway
# Auto-initialize database schema on first run (runs database/schema.sql)
GATEWAY_DATABASE__AUTO_INIT=true

# ======================== Redis ========================
GATEWAY_REDIS__ENABLED=true
GATEWAY_REDIS__URL=redis://:YOUR_PASSWORD@localhost:6379/0

# ======================== Authentication - JWT ========================
GATEWAY_AUTHENTICATION__JWT__ENABLED=true
GATEWAY_AUTHENTICATION__JWT__SECRET=your-jwt-secret-key-change-in-production
GATEWAY_AUTHENTICATION__JWT__ALGORITHMS=["HS256"]
# GATEWAY_AUTHENTICATION__JWT__AUDIENCE=your-audience
# GATEWAY_AUTHENTICATION__JWT__ISSUER=your-issuer

# ======================== Authentication - API Key ========================
GATEWAY_AUTHENTICATION__API_KEY__ENABLED=false
GATEWAY_AUTHENTICATION__API_KEY__HEADER_NAME=X-API-Key
# GATEWAY_AUTHENTICATION__API_KEY__KEYS=["key1","key2"]

# ======================== Rate Limiting ========================
GATEWAY_RATE_LIMITS__ENABLED=false
# GATEWAY_RATE_LIMITS__GLOBAL_LIMIT={"requests": 10000, "window": 60}
# GATEWAY_RATE_LIMITS__IP_LIMITS={"requests": 30, "window": 60}

# ======================== LangGraph ========================
GATEWAY_LANGGRAPH__ENABLED=true
GATEWAY_LANGGRAPH__LOAD_BALANCER_STRATEGY=least_connections
GATEWAY_LANGGRAPH__HEALTH_CHECK_INTERVAL=10
# Comma-separated URLs for multiple instances
GATEWAY_LANGGRAPH__INSTANCE_URLS=http://localhost:2024
# Internal auth token for gateway <-> LangGraph communication
GATEWAY_LANGGRAPH__AUTH_TOKEN=your-internal-token

# ======================== Knowledge Base (KBMS) ========================
GATEWAY_KNOWLEDGE__ENABLED=true
GATEWAY_KNOWLEDGE__WORKER_CONCURRENCY=2

# Qdrant Vector Database
GATEWAY_KNOWLEDGE__QDRANT__ENABLED=true
GATEWAY_KNOWLEDGE__QDRANT__URL=http://localhost:6333
# GATEWAY_KNOWLEDGE__QDRANT__API_KEY=

# DashScope + Google (Gemini / Vertex) — the "general" keys below power
# all three LLM domains (chat, image gen, embedding) by default. Each
# domain has its own optional override block further down so operators
# can flip chat / image / embedding between free and paid endpoints
# independently.
# GATEWAY_KNOWLEDGE__DASHSCOPE__API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx           # general key — used when per-domain unset
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com  # general host override
# GATEWAY_KNOWLEDGE__GEMINI__API_KEY=your-gemini-api-key
# GEMINI_API_KEY=AIzaSy...           # Google AI Studio key (chat + image)
# GOOGLE_API_KEY=AIzaSy...           # legacy alias, same shape
# VERTEX_API_KEY=AQ.xxx              # Vertex Express Mode (general fallback)

# =============================================================================
# Per-domain endpoint-switch (chat / image / embedding)
# =============================================================================
# Each of the three domains (chat, image gen, embedding) supports an
# independent free ⇄ paid swap by setting the domain-specific env vars
# below. Resolution order is: DOMAIN-specific → GENERAL → default.
# So operators who only want a single key just set DASHSCOPE_API_KEY +
# GEMINI_API_KEY and everything flows through; operators wanting
# chat-free-image-paid-embedding-paid set only the DASHSCOPE_CHAT_*
# + DASHSCOPE_CHAT_BASE_URL pair (+ GOOGLE_CHAT_BACKEND for Gemini).
#
# See packages/ai-gateway-core/src/ai_gateway_core/config/endpoints.py
# for the exact fallback chain and semantics.
#
# --- CHAT domain ---
# DashScope CN (paid) ⇄ Intl (free trial):
# DASHSCOPE_CHAT_API_KEY=sk-intl-xxx
# DASHSCOPE_CHAT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode
# Google AI Studio ⇄ Vertex Express:
# GOOGLE_CHAT_BACKEND=vertex          # "ai_studio" | "vertex" (default ai_studio)
# VERTEX_CHAT_API_KEY=AQ.xxx          # Express-Mode key for chat only
#
# --- IMAGE domain ---
# DashScope Wanx text2image swap:
# DASHSCOPE_IMAGE_API_KEY=sk-xxx
# DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
# Google Gemini image gen on Vertex vs AI Studio. NOTE: the Gemini Files
# API (used by multi-turn image editing) is AI-Studio-only — if you flip
# image gen to Vertex, uploads still route to AI Studio host, and the
# returned file URIs are reusable from the Vertex generateContent call.
# GOOGLE_IMAGE_BACKEND=vertex
# VERTEX_IMAGE_API_KEY=AQ.xxx
#
# --- EMBEDDING domain ---
# DashScope text-embedding-v3/v4 + multimodal embedding swap:
# DASHSCOPE_EMBEDDING_API_KEY=sk-xxx
# DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com
# Google gemini-embedding-001 on Vertex vs AI Studio:
# GOOGLE_EMBEDDING_BACKEND=vertex
# VERTEX_EMBEDDING_API_KEY=AQ.xxx
#
# --- Legacy (still honored, deprecated) ---
# Old global flag pre-dating per-domain config — flips Google default to
# Vertex for every domain (chat + image + embedding). Prefer
# GOOGLE_CHAT_BACKEND / GOOGLE_IMAGE_BACKEND / GOOGLE_EMBEDDING_BACKEND
# when you want per-domain control.
# GOOGLE_API_BACKEND=vertex
# GOOGLE_VERTEX_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite-preview

# SiliconFlow Embedding (recommended for AR+EN datasets, e.g. BGE-M3)
# GATEWAY_KNOWLEDGE__SILICONFLOW__API_KEY=your-siliconflow-api-key
# GATEWAY_KNOWLEDGE__SILICONFLOW__BASE_URL=https://api.siliconflow.cn/v1

# Optional Islamic profile defaults (applies only when chunking.mode=islamic
# or retrieval.islamic is explicitly configured)
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__ENABLED=true
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__TOP_K=8
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__SCORE_THRESHOLD=0.3
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__RERANK_ENABLED=false
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__RERANK_PROVIDER=bge
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__RERANK_MODEL=bge-reranker-v2-m3
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__MULTI_QUERY=false
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__CITATION_FORMAT=true
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__AUTHORITY_SORT=true
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__STRICT_SECTION_TRACEABILITY=true
# GATEWAY_KNOWLEDGE__ISLAMIC_PROFILE__MAX_EXPANDED_QUERIES=3


# ======================== Transparent Proxy ========================
GATEWAY_PROXY__ENABLED=true
GATEWAY_PROXY__TIMEOUT_CONNECT=5.0
GATEWAY_PROXY__TIMEOUT_READ=300.0
GATEWAY_PROXY__TIMEOUT_WRITE=60.0
GATEWAY_PROXY__BILLING_ENABLED=true

# ======================== Anonymous Identity ========================
GATEWAY_ANONYMOUS__ENABLED=true
GATEWAY_ANONYMOUS__COOKIE_NAME=ag_anon_id
GATEWAY_ANONYMOUS__TTL_DAYS=30

# ======================== Session ========================
GATEWAY_SESSION__ANONYMOUS_TTL_SECONDS=86400
GATEWAY_SESSION__AUTHENTICATED_TTL_SECONDS=604800

# ======================== Object Storage ========================
# Storage backend: local | s3 | oss
GATEWAY_STORAGE__BACKEND=s3

# S3 / S3-compatible storage (MinIO, etc.)
GATEWAY_STORAGE__S3__BUCKET=your-bucket-name
GATEWAY_STORAGE__S3__REGION=us-east-1
GATEWAY_STORAGE__S3__ACCESS_KEY=your-access-key
GATEWAY_STORAGE__S3__SECRET_KEY=your-secret-key
# For S3-compatible services (MinIO, etc.), set endpoint URL:
# GATEWAY_STORAGE__S3__ENDPOINT_URL=http://minio:9000

# Aliyun OSS (alternative to S3)
# GATEWAY_STORAGE__BACKEND=oss
# GATEWAY_STORAGE__OSS__BUCKET=your-bucket-name
# GATEWAY_STORAGE__OSS__ENDPOINT=oss-cn-beijing.aliyuncs.com
# GATEWAY_STORAGE__OSS__ACCESS_KEY=your-access-key
# GATEWAY_STORAGE__OSS__SECRET_KEY=your-secret-key

# Environment key prefix for S3 path isolation (e.g., dev, staging, prod)
# All storage keys will be prefixed: {prefix}/knowledge/..., {prefix}/artifacts/..., etc.
GATEWAY_STORAGE__KEY_PREFIX=dev

# Pre-signed URL expiry time (seconds)
GATEWAY_STORAGE__URL_EXPIRY_SECONDS=3600

# ======================== File Upload Limits ========================
# Maximum file size in MB
MAX_FILE_SIZE_MB=50

# ======================== Microservice URLs ========================
# Islamic Content Service (transparent proxy target)
ISLAMIC_CONTENT_SERVICE_URL=http://islamic-content:8091
# Knowledge Base Service (transparent proxy target)
# KB_SERVICE_URL=http://knowledge-service:8092

# ======================== Web Search (Tavily) ========================
# Tavily API for web search in assistant - get key at https://app.tavily.com
# TAVILY_API_KEY=tvly-xxx

# ======================== Docker Compose (Required) ========================
# These variables are REQUIRED by docker-compose.yml (no defaults).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
# Shared HMAC between gateway and assistant-service (Phase 5a).
# Both containers MUST have the same value, or /api/v1/assistant/*
# returns 401. Generate with ``openssl rand -hex 32``.
GATEWAY_ASSISTANT_SHARED_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# CORS allowed origins (comma-separated, used by microservices)
CORS_ALLOW_ORIGINS=http://localhost:80,http://localhost:3000
