{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "docgen": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "mcp_docgen_server"],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "DOCGEN_ARTIFACT_ROOT": "${PLUGIN_DATA}/artifacts",
        "PYTHONUNBUFFERED": "1"
      },
      "cwd": "${PLUGIN_DATA}"
    }
  }
}
