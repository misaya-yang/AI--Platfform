# =============================================================================
# AI Gateway .gitignore
# =============================================================================

# ======================== Environment & Secrets ========================
# Local environment configuration (contains secrets)
.env
.env.local
.env.*.local

# ======================== Python ========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# ======================== Testing & Coverage ========================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ======================== Type Checking & Linting ========================
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ======================== IDE & Editor ========================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
.csv

# ======================== Claude Code ========================
.claude/settings.local.json
.claude/skills/
plugins/frontend-design/

# AI Agent Skills (local development only)
.agents/

# Documentation (managed separately, except Islamic content handoff docs)
docs/
!apps/islamic-content-service/docs/
!apps/islamic-content-service/docs/**

# ======================== Data & Models ========================
# Downloaded ML models (OCR, embeddings, etc.)
data/models/
data/islamic_content/
*.pdmodel
*.pdiparams
*.pdiparams.info
*.tar
*.onnx
*.bin

# ======================== Logs & Temp Files ========================
*.log
.err
.out
logs/*.log
logs/*.log.*
tmp/
temp/
claude/

# ======================== OS Generated ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows reserved names
nul
NUL

# ======================== Debug & Temporary Scripts ========================
check_*.py
check_*.json
quick_test*.py
test_output*.txt
*_debug.py
debug_*.py
.worktrees
.mcp.json
apps/islamic-content-service/data/

# ======================== Screenshots & Playwright ========================
*.png
*.jpeg
.playwright-mcp/

# ======================== Audit & Planning Docs ========================
