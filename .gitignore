# =============================================================================
# AI Gateway .gitignore
# =============================================================================

# ======================== Environment & Secrets ========================
# Local environment configuration (contains secrets).
# Also covers ad-hoc backups (.env.bak.YYYYMMDD-HHMMSS) and scratch
# copies (.env.copy) that prior ops sessions left behind — they contain
# the same secrets as the live .env and must never be committed.
.env
/.env.example
.env.local
.env.*.local
.env.bak
.env.bak.*
.env.copy
.env.*.bak

# ======================== Python ========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

# ======================== Testing & Coverage ========================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ======================== Type Checking & Linting ========================
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ======================== IDE & Editor ========================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/
.csv

# ======================== Claude Code ========================
.claude/settings.local.json
.claude/skills/
plugins/frontend-design/

# AI Agent Skills (local development only)
.agents/

# Documentation (managed separately, except Islamic content handoff docs)
docs/
!apps/islamic-content-service/docs/
!apps/islamic-content-service/docs/**
!apps/assistant-service/docs/
!apps/assistant-service/docs/**

# ======================== Data & Models ========================
# Downloaded ML models (OCR, embeddings, etc.)
data/models/
data/islamic_content/
*.pdmodel
*.pdiparams
*.pdiparams.info
*.tar
*.onnx
*.bin

# ======================== Logs & Temp Files ========================
*.log
.err
.out
logs/*.log
logs/*.log.*
tmp/
temp/
claude/
outputs/
node_modules/

# ======================== OS Generated ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows reserved names
nul
NUL

# ======================== Debug & Temporary Scripts ========================
check_*.py
check_*.json
quick_test*.py
test_output*.txt
*_debug.py
debug_*.py
.worktrees
.mcp.json
apps/islamic-content-service/data/

# ======================== Screenshots & Playwright ========================
*.png
*.jpeg
.playwright-mcp/

# ======================== Audit & Planning Docs ========================
# These are development artifacts, not source code
*-Audit-*.md
*-Optimization-*.md
*-Report*.md
*-Report*.docx
*-Report*.js
*-Spec.md
claude-code-*.md
# plans/ holds migration plans and generated reports. Track .md + .json
# (committable deliverables); ignore any other scratch/binary artifacts
# that land alongside.
plans/*
!plans/*.md
!plans/*.json
# Verify scripts belong with their design docs so "the gate the user
# runs" is always reviewable next to the spec it enforces.
!plans/verify-*.sh
docs/plans/
docs/architecture/

# ======================== Temporary Upload/Data ========================
tmp-*/
demo-screenshots/
Users/
code-review-recommended-questions.md
deploy-checklist-recommended-questions.md
code-review-recommended-questions.md
docs/screenshots/

# ======================== Generated / Temp ========================
web/package-lock.json
docs/reviews/
# Generated data files
data/hadith_registry.json

# Old reports
AI-*.md
CLAUDE_CODE_OPTIMIZATION_PROMPT.md

# Test output
test-results/
.claude/worktrees/
